{"id":14183,"date":"2022-06-07T11:10:52","date_gmt":"2022-06-07T15:10:52","guid":{"rendered":"https:\/\/depictdatastudio.com\/?page_id=14183"},"modified":"2026-02-13T14:47:32","modified_gmt":"2026-02-13T19:47:32","slug":"workshops","status":"publish","type":"page","link":"https:\/\/depictdatastudio.com\/workshops\/","title":{"rendered":"Private Workshops"},"content":{"rendered":"<style>body.view_tablet #f-this-el-285{padding-right:10% !important;}body.view_mobile #f-this-el-285{padding-top:50px !important;padding-right:5% !important;padding-bottom:50px !important;padding-left:5% !important;}body.view_tablet #f-this-el-286{width:100% !important;padding-right:0px !important;margin-bottom:30px !important;}body.view_mobile #f-this-el-395{display:block !important;}body.view_mobile #f-this-el-314{padding-top:0px !important;padding-right:5% !important;padding-bottom:50px !important;padding-left:5% !important;}body.view_mobile #f-this-el-317{padding-top:50px !important;padding-right:5% !important;padding-bottom:50px !important;padding-left:5% !important;}<\/style>\n<style>#f-this-el-291 a{color:#262626}<\/style>\n<div class=\"pb-area\">\n<div class=\"elements\">\n<div id=\"f-this-el-285\" class=\"block has-fullsize has-parallax\" data-ratio=\"2.5316455696202533\" style=\"padding: 200px 10%; position: relative; background-image: url('||WP:featured_image_url||https:\/\/ffscdn.s3.us-east-1.amazonaws.com\/depictdatastudio.com\/2026\/02\/AnnKEmery_Website4-scaled.png'); background-repeat: repeat; background-attachment: scroll; background-color: rgba(246, 242, 255, 0); background-clip: border-box; background-size: 0px 0px; background-position: 0px 0px;\">\n<div class=\"elements\">\n<div id=\"f-this-el-311\" class=\"block\" style=\"margin-right: auto; margin-left: auto; width: 100%; max-width: 1200px; float: none; position: relative; z-index: 10;\">\n<div class=\"elements\">\n<div id=\"f-this-el-286\" class=\"block\" style=\"width: 100%; text-align: left;\">\n<div class=\"elements\">\n<h1 id=\"f-this-el-290\" style=\"margin-bottom: 30px;\">Workshops<\/h1>\n<div id=\"f-this-el-291\" class=\"text\" style=\"margin-bottom: 15px; max-width: 425px;\">Private trainings just for your team &mdash; in-person or virtual.<\/div>\n<p><a id=\"f-this-el-396\" class=\"button\" href=\"#book-a-call\" title=\"Book a Call\" data-label=\"\">Book a Call<\/a><\/div>\n<\/div>\n<\/div>\n<\/div>\n<div id=\"f-this-el-395\" class=\"block kdm-fill\" style=\"width: 100%; z-index: 5; display: none; background-color: rgba(255, 255, 255, 0.7);\"><\/div>\n<\/div>\n<p><script>do_fullsize( '#f-this-el-285' );<\/script><\/p>\n<div class=\"parallax-image\"><img decoding=\"async\" src=\"||WP:featured_image_url||https:\/\/ffscdn.s3.us-east-1.amazonaws.com\/depictdatastudio.com\/2026\/02\/AnnKEmery_Website4-scaled.png\"><\/div>\n<\/div>\n<div id=\"f-this-el-314\" class=\"block\" style=\"padding-right: 10%; padding-bottom: 75px; padding-left: 10%; margin-top: -45px; position: relative; z-index: 10;\">\n<div class=\"elements\">\n<div id=\"f-this-el-315\" class=\"block grid grid3\" style=\"margin-right: auto; margin-left: auto; width: 100%; max-width: 1200px; float: none; position: relative; z-index: 10; color: rgb(255, 255, 255); text-align: center;\">\n<div class=\"elements\">\n<div id=\"f-this-el-319\" class=\"block\" style=\"width: auto;\">\n<div class=\"elements\"><img decoding=\"async\" src=\"https:\/\/ffscdn.s3.us-east-1.amazonaws.com\/depictdatastudio.com\/2023\/01\/Ontario-Council-for-International-Cooperation-in-2016-Oval.png\" alt=\"\" title=\"\" id=\"f-this-el-332\" style=\"margin-bottom: 30px; display: block;\"><\/p>\n<div id=\"f-this-el-320\" class=\"block\" style=\"padding: 40px; margin-bottom: 30px; width: 100%; float: none; background-color: rgb(255, 255, 255); border-radius: 16px;\">\n<div class=\"elements\">\n<div id=\"f-this-el-321\" class=\"text\" style=\"margin-bottom: 20px; font-size: 18px; line-height: 24px; font-weight: 800; color: rgb(75, 38, 149);\">Live, Custom Training for Your Team<\/div>\n<div id=\"f-this-el-322\" class=\"text\" style=\"color: rgb(38, 38, 38); text-align: left;\">The most popular option is <strong>8 hours of live training<\/strong> (1 day on-site, or 2 half-days virtually).<\/div>\n<\/div>\n<\/div>\n<p><img decoding=\"async\" src=\"https:\/\/ffscdn.s3.us-east-1.amazonaws.com\/depictdatastudio.com\/2025\/03\/CDC-South-Africa-Oval.jpg.png\" alt=\"\" title=\"\" id=\"f-this-el-524\" style=\"margin-bottom: 30px; display: block;\"><\/p>\n<div id=\"f-this-el-329\" class=\"block\" style=\"padding: 40px; margin-bottom: 30px; width: 100%; float: none; background-color: rgb(255, 255, 255); border-radius: 16px;\">\n<div class=\"elements\">\n<div id=\"f-this-el-330\" class=\"text\" style=\"margin-bottom: 20px; font-size: 18px; line-height: 24px; font-weight: 800; color: rgb(75, 38, 149);\">Review of 5-10 Sample Materials<\/div>\n<div id=\"f-this-el-331\" class=\"text\" style=\"color: rgb(38, 38, 38); text-align: left;\">I&rsquo;ll review your dashboards, slides, reports, and\/or one-pagers to see <strong>how staff are currently visualizing data<\/strong>.<\/div>\n<\/div>\n<\/div>\n<p><img decoding=\"async\" src=\"https:\/\/ffscdn.s3.us-east-1.amazonaws.com\/depictdatastudio.com\/2022\/06\/depict-data-studio-workshops-3.png\" alt=\"\" title=\"\" id=\"f-this-el-533\" style=\"margin-bottom: 30px; display: block;\"><\/p>\n<div id=\"f-this-el-378\" class=\"block\" style=\"padding: 40px; margin-bottom: 30px; width: 100%; float: none; background-color: rgb(255, 255, 255); border-radius: 16px;\">\n<div class=\"elements\">\n<div id=\"f-this-el-379\" class=\"text\" style=\"margin-bottom: 20px; font-size: 18px; line-height: 24px; font-weight: 800; color: rgb(75, 38, 149);\">Recordings for 1 Full Year<\/div>\n<div id=\"f-this-el-380\" class=\"text\" style=\"color: rgb(38, 38, 38); text-align: left;\">Worried you won&#8217;t remember everything?<\/p>\n<p>You&rsquo;ll get access to your password-protected recordings <strong>for an entire year<\/strong> &#8212; for both virtual <em>and<\/em> in-person events.<\/p>\n<\/div>\n<\/div>\n<\/div>\n<div id=\"f-this-el-382\" class=\"block\" style=\"padding: 40px; margin-bottom: 30px; width: 100%; float: none; background-color: rgb(255, 255, 255); border-radius: 16px;\">\n<div class=\"elements\">\n<div id=\"f-this-el-383\" class=\"text\" style=\"margin-bottom: 20px; font-size: 18px; line-height: 24px; font-weight: 800; color: rgb(75, 38, 149);\">Alumni Community<\/div>\n<div id=\"f-this-el-384\" class=\"text\" style=\"color: rgb(38, 38, 38); text-align: left;\">You&rsquo;ll be invited to my private LinkedIn group, where you can <strong>post drafts and get feedback<\/strong> from me and my <strong>community of 500 like-minded data vizards<\/strong>.<\/div>\n<\/div>\n<\/div>\n<p><img decoding=\"async\" src=\"https:\/\/ffscdn.s3.us-east-1.amazonaws.com\/depictdatastudio.com\/2023\/01\/United-Nations-v2.png\" alt=\"\" title=\"\" id=\"f-this-el-333\" style=\"margin-bottom: 30px; display: block;\"><\/p>\n<div id=\"f-this-el-498\" class=\"block\" style=\"padding: 40px; margin-bottom: 30px; width: 100%; float: none; background-color: rgb(255, 255, 255); border-radius: 16px;\">\n<div class=\"elements\">\n<div id=\"f-this-el-499\" class=\"text\" style=\"margin-bottom: 20px; font-size: 18px; line-height: 24px; font-weight: 800; color: rgb(75, 38, 149);\">Style Guide Consultations<\/div>\n<div id=\"f-this-el-500\" class=\"text\" style=\"color: rgb(38, 38, 38); text-align: left;\">We&rsquo;ll review your existing branding materials together. Then, we&rsquo;ll set up chart templates and go through my <strong>Dataviz Style Guide Checklist<\/strong>. <\/p>\n<p>Templates <strong>save time<\/strong> and help you look <strong>consistent and professional<\/strong>.<\/p>\n<\/div>\n<\/div>\n<\/div>\n<p><img decoding=\"async\" src=\"https:\/\/ffscdn.s3.us-east-1.amazonaws.com\/depictdatastudio.com\/2025\/03\/University-of-South-Carolina-in-2019-5-Oval.png\" alt=\"\" title=\"\" id=\"f-this-el-535\" style=\"margin-bottom: 30px; display: block;\"><\/div>\n<\/div>\n<div id=\"f-this-el-340\" class=\"block\" style=\"width: auto;\">\n<div class=\"elements\"><img decoding=\"async\" src=\"https:\/\/ffscdn.s3.us-east-1.amazonaws.com\/depictdatastudio.com\/2023\/01\/Centers-for-Disease-Control-in-2019-in-Hyattsville-Oval.png\" alt=\"\" title=\"\" id=\"f-this-el-347\" style=\"margin-bottom: 30px; display: block;\"><\/p>\n<div id=\"f-this-el-344\" class=\"block\" style=\"padding: 40px; margin-bottom: 30px; width: 100%; float: none; background-color: rgb(255, 255, 255); border-radius: 16px;\">\n<div class=\"elements\">\n<div id=\"f-this-el-345\" class=\"text\" style=\"margin-bottom: 20px; font-size: 18px; line-height: 24px; font-weight: 800; color: rgb(75, 38, 149);\">6 Classes to Choose From<\/div>\n<div id=\"f-this-el-346\" class=\"text\" style=\"color: rgb(38, 38, 38); text-align: left;\">You&#8217;ll <strong>choose one of my 6 classes<\/strong>.&nbsp;<\/p>\n<p>We&#8217;ll focus on spreadsheets, dataviz best practices, dataviz how-to&#8217;s in Excel, reports, presentations, <em>or<\/em> dashboards. I&#8217;ll help you figure out which class is best for your staff.<\/p>\n<\/div>\n<\/div>\n<\/div>\n<p><img decoding=\"async\" src=\"https:\/\/ffscdn.s3.us-east-1.amazonaws.com\/depictdatastudio.com\/2025\/03\/CDC-South-Africa-Oval-2.jpg.png\" alt=\"\" title=\"\" id=\"f-this-el-351\" style=\"margin-bottom: 30px; display: block;\"><\/p>\n<div id=\"f-this-el-502\" class=\"block\" style=\"padding: 40px; margin-bottom: 30px; width: 100%; float: none; background-color: rgb(255, 255, 255); border-radius: 16px;\">\n<div class=\"elements\">\n<div id=\"f-this-el-503\" class=\"text\" style=\"margin-bottom: 20px; font-size: 18px; line-height: 24px; font-weight: 800; color: rgb(75, 38, 149);\">Excel Templates<\/div>\n<div id=\"f-this-el-504\" class=\"text\" style=\"color: rgb(38, 38, 38); text-align: left;\">Don&rsquo;t have time to fight with Excel?<\/p>\n<div><\/div>\n<div>If you choose my <em>Great Graphs in Excel<\/em> class, then all 25 of your staff will get my zip folder of <strong>31+ Excel templates<\/strong>, which includes <strong> step-by-step instructions<\/strong> for making beginner, intermediate, and advanced graphs.<\/div>\n<\/div>\n<\/div>\n<\/div>\n<p><img decoding=\"async\" src=\"https:\/\/ffscdn.s3.us-east-1.amazonaws.com\/depictdatastudio.com\/2022\/06\/depict-data-studio-workshops-4.png\" alt=\"\" title=\"\" id=\"f-this-el-534\" style=\"margin-bottom: 30px; display: block;\"><\/p>\n<div id=\"f-this-el-386\" class=\"block\" style=\"padding: 40px; margin-bottom: 30px; width: 100%; float: none; background-color: rgb(255, 255, 255); border-radius: 16px;\">\n<div class=\"elements\">\n<div id=\"f-this-el-387\" class=\"text\" style=\"margin-bottom: 20px; font-size: 18px; line-height: 24px; font-weight: 800; color: rgb(75, 38, 149);\">Course Access<\/div>\n<div id=\"f-this-el-388\" class=\"text\" style=\"color: rgb(38, 38, 38); text-align: left;\">You&rsquo;ll get <strong>lifetime access<\/strong> to one of my online courses, which goes <strong>broader and deeper<\/strong> than our training together.<\/div>\n<\/div>\n<\/div>\n<p><img decoding=\"async\" src=\"https:\/\/ffscdn.s3.us-east-1.amazonaws.com\/depictdatastudio.com\/2022\/06\/depict-data-studio-workshops-7.png\" alt=\"\" title=\"\" id=\"f-this-el-389\" style=\"margin-bottom: 30px; display: block;\"><\/p>\n<div id=\"f-this-el-348\" class=\"block\" style=\"padding: 40px; margin-bottom: 30px; width: 100%; float: none; background-color: rgb(255, 255, 255); border-radius: 16px;\">\n<div class=\"elements\">\n<div id=\"f-this-el-349\" class=\"text\" style=\"margin-bottom: 20px; font-size: 18px; line-height: 24px; font-weight: 800; color: rgb(75, 38, 149);\">Accessibility Audits<\/div>\n<div id=\"f-this-el-350\" class=\"text\" style=\"color: rgb(38, 38, 38); text-align: left;\">I&rsquo;ll review one of your projects for both <strong>&ldquo;Big A Accessibility&rdquo;<\/strong> (508\/ADA) and <strong>&ldquo;little a accessibility&rdquo;<\/strong> (making sure it&rsquo;s easy to understand).<\/div>\n<\/div>\n<\/div>\n<p><img decoding=\"async\" src=\"https:\/\/ffscdn.s3.us-east-1.amazonaws.com\/depictdatastudio.com\/2023\/01\/NeighborWorks-in-2015-4-Oval.png\" alt=\"\" title=\"\" id=\"f-this-el-525\" style=\"margin-bottom: 30px; display: block;\"><\/p>\n<div id=\"f-this-el-520\" class=\"block\" style=\"padding: 40px; margin-bottom: 30px; width: 100%; float: none; background-color: rgb(255, 255, 255); border-radius: 16px;\">\n<div class=\"elements\">\n<div id=\"f-this-el-521\" class=\"text\" style=\"margin-bottom: 20px; font-size: 18px; line-height: 24px; font-weight: 800; color: rgb(75, 38, 149);\">Office Hours<\/div>\n<div id=\"f-this-el-522\" class=\"text\" style=\"color: rgb(38, 38, 38); text-align: left;\">You&rsquo;ll be invited to <strong>near-weekly Q&amp;A&rsquo;s<\/strong> for an entire year to make sure <strong>you&rsquo;re supported for the long run<\/strong>.<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<div id=\"f-this-el-353\" class=\"block\" style=\"width: auto;\">\n<div class=\"elements\"><img decoding=\"async\" src=\"https:\/\/ffscdn.s3.us-east-1.amazonaws.com\/depictdatastudio.com\/2022\/06\/depict-data-studio-workshops-2.png\" alt=\"\" title=\"\" id=\"f-this-el-354\" style=\"margin-bottom: 30px; display: block;\"><\/p>\n<div id=\"f-this-el-490\" class=\"block\" style=\"padding: 40px; margin-bottom: 30px; width: 100%; float: none; background-color: rgb(255, 255, 255); border-radius: 16px;\">\n<div class=\"elements\">\n<div id=\"f-this-el-491\" class=\"text\" style=\"margin-bottom: 20px; font-size: 18px; line-height: 24px; font-weight: 800; color: rgb(75, 38, 149);\">Customized Agenda<\/div>\n<div id=\"f-this-el-492\" class=\"text\" style=\"color: rgb(38, 38, 38); text-align: left;\">After I review your sample materials, I&rsquo;ll customize the agenda. <\/p>\n<p>For example, we might choose to <strong>focus on qualitative data, mapping, or interactive dashboards<\/strong>.<\/p>\n<\/div>\n<\/div>\n<\/div>\n<p><img decoding=\"async\" src=\"https:\/\/ffscdn.s3.us-east-1.amazonaws.com\/depictdatastudio.com\/2022\/06\/depict-data-studio-workshops-1.png\" alt=\"\" title=\"\" id=\"f-this-el-390\" style=\"margin-bottom: 30px; display: block;\"><\/p>\n<div id=\"f-this-el-506\" class=\"block\" style=\"padding: 40px; margin-bottom: 30px; width: 100%; float: none; background-color: rgb(255, 255, 255); border-radius: 16px;\">\n<div class=\"elements\">\n<div id=\"f-this-el-507\" class=\"text\" style=\"margin-bottom: 20px; font-size: 18px; line-height: 24px; font-weight: 800; color: rgb(75, 38, 149);\">Ebooks<\/div>\n<div id=\"f-this-el-508\" class=\"text\" style=\"color: rgb(38, 38, 38); text-align: left;\">You&rsquo;ll get licenses to one or more of my ebooks with <strong>case studies from industries like yours<\/strong>.<\/div>\n<\/div>\n<\/div>\n<p><img decoding=\"async\" src=\"https:\/\/ffscdn.s3.us-east-1.amazonaws.com\/depictdatastudio.com\/2023\/01\/Kampala-Uganda-2014-v2-1.png\" alt=\"\" title=\"\" id=\"f-this-el-526\" style=\"margin-bottom: 30px; display: block;\"><\/p>\n<div id=\"f-this-el-510\" class=\"block\" style=\"padding: 40px; margin-bottom: 30px; width: 100%; float: none; background-color: rgb(255, 255, 255); border-radius: 16px;\">\n<div class=\"elements\">\n<div id=\"f-this-el-511\" class=\"text\" style=\"margin-bottom: 20px; font-size: 18px; line-height: 24px; font-weight: 800; color: rgb(75, 38, 149);\">Supplemental Materials<\/div>\n<div id=\"f-this-el-512\" class=\"text\" style=\"color: rgb(38, 38, 38); text-align: left;\">You&rsquo;ll get my <strong>slides, handouts, and resource lists<\/strong> to save time and remove guesswork.<\/div>\n<\/div>\n<\/div>\n<p><img decoding=\"async\" src=\"https:\/\/ffscdn.s3.us-east-1.amazonaws.com\/depictdatastudio.com\/2022\/06\/depict-data-studio-workshops-5.png\" alt=\"\" title=\"\" id=\"f-this-el-517\" style=\"margin-bottom: 30px; display: block;\"><\/p>\n<div id=\"f-this-el-494\" class=\"block\" style=\"padding: 40px; margin-bottom: 30px; width: 100%; float: none; background-color: rgb(255, 255, 255); border-radius: 16px;\">\n<div class=\"elements\">\n<div id=\"f-this-el-495\" class=\"text\" style=\"margin-bottom: 20px; font-size: 18px; line-height: 24px; font-weight: 800; color: rgb(75, 38, 149);\">5 Hours of Follow-Up Support<\/div>\n<div id=\"f-this-el-496\" class=\"text\" style=\"color: rgb(38, 38, 38); text-align: left;\">Have questions after our private workshop? <\/p>\n<p><strong>You&rsquo;ll get 5 hours of follow-up consulting &ndash; via email or Zoom<\/strong>, your choice. <\/p>\n<\/div>\n<\/div>\n<\/div>\n<p><img decoding=\"async\" src=\"https:\/\/ffscdn.s3.us-east-1.amazonaws.com\/depictdatastudio.com\/2023\/01\/Centers-for-Disease-Control-png.png\" alt=\"\" title=\"\" id=\"f-this-el-523\" style=\"margin-bottom: 30px; display: block;\"><\/p>\n<div id=\"f-this-el-530\" class=\"block\" style=\"padding: 40px; margin-bottom: 30px; width: 100%; float: none; background-color: rgb(255, 255, 255); border-radius: 16px;\">\n<div class=\"elements\">\n<div id=\"f-this-el-531\" class=\"text\" style=\"margin-bottom: 20px; font-size: 18px; line-height: 24px; font-weight: 800; color: rgb(75, 38, 149);\">3 Before-After Data Visualization Makeovers<\/div>\n<div id=\"f-this-el-532\" class=\"text\" style=\"color: rgb(38, 38, 38); text-align: left;\">Want to see how these principles can be <strong>applied to your datasets<\/strong>? <\/p>\n<p>I&rsquo;ll design 3 makeovers (e.g., a page from your report, a slide from your slideshow, and a graph from your dashboard).<\/p>\n<\/div>\n<\/div>\n<\/div>\n<p><img decoding=\"async\" src=\"https:\/\/ffscdn.s3.us-east-1.amazonaws.com\/depictdatastudio.com\/2025\/04\/Eau-Claire-City-County-Health-Dept-WI_2024-04_2_Rounded.png\" alt=\"\" title=\"\" id=\"f-this-el-518\" style=\"margin-bottom: 30px; display: block;\"><\/div>\n<\/div>\n<\/div>\n<\/div>\n<div id=\"f-this-el-338\" class=\"block kdm-fill\" style=\"width: 100%; z-index: 5; top: 45px; background-color: rgb(246, 243, 255);\"><\/div>\n<div id=\"f-this-el-397\" class=\"text\">\n<div id=\"book-a-call\"> <\/div>\n<\/div>\n<\/div>\n<\/div>\n<div id=\"f-this-el-317\" class=\"block\" style=\"padding: 75px 10%; background-color: rgb(100, 50, 198);\">\n<div class=\"elements\">\n<div id=\"f-this-el-318\" class=\"block\" style=\"margin-right: auto; margin-left: auto; width: 100%; max-width: 800px; float: none;\">\n<div class=\"elements\">\n<h2 id=\"f-this-el-370\" style=\"margin-bottom: 30px; font-weight: 600; color: rgb(255, 255, 255); text-align: center;\">Interested in learning more? <span style=\"font-weight:800\">Book a call<\/span>.<\/h2>\n<div id=\"f-this-el-398\" class=\"text\" style=\"color: rgb(255, 255, 255);\">You&#8217;ll tell me about <strong>your organization, your staff, and your training needs<\/strong>. I&#8217;ll tell you about <strong>similar trainings<\/strong> I&#8217;ve done in the past. Then, we&#8217;ll put our heads together and <strong>develop a customized training<\/strong> that&#8217;s just right for your team.<\/div>\n<div id=\"f-this-el-371\" class=\"text\">\n<div class=\"calendly-inline-widget\" data-url=\"https:\/\/calendly.com\/depictdatastudio\/dataviz-training-options\" style=\"min-width:320px;height:1150px;\"><\/div>\n<p>[script type=&#8221;text\/javascript&#8221; src=&#8221;https:\/\/assets.calendly.com\/assets\/external\/widget.js&#8221; async][\/script]<\/p><\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<p>||WP:global[id=globals-el-16]||||WP:global[id=globals-el-1]||<\/p><\/div>\n<\/div>\n","protected":false},"excerpt":{"rendered":"<p>Workshops Private trainings just for your team &mdash; in-person or virtual. Book a Call Live, Custom Training for Your Team The most popular option is 8 hours of live training (1 day on-site, or 2 half-days virtually). Review of 5-10 Sample Materials I&rsquo;ll review your dashboards, slides, reports, and\/or one-pagers to see how staff are &#8230; <a class=\"read-more\" href=\"https:\/\/depictdatastudio.com\/workshops\/\">more &raquo;<\/a><\/p>\n","protected":false},"author":35,"featured_media":71,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false,"footnotes":""},"class_list":["post-14183","page","type-page","status-publish","has-post-thumbnail","hentry"],"acf":[],"_links":{"self":[{"href":"https:\/\/depictdatastudio.com\/wp-json\/wp\/v2\/pages\/14183","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/depictdatastudio.com\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/depictdatastudio.com\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"https:\/\/depictdatastudio.com\/wp-json\/wp\/v2\/users\/35"}],"replies":[{"embeddable":true,"href":"https:\/\/depictdatastudio.com\/wp-json\/wp\/v2\/comments?post=14183"}],"version-history":[{"count":59,"href":"https:\/\/depictdatastudio.com\/wp-json\/wp\/v2\/pages\/14183\/revisions"}],"predecessor-version":[{"id":16591,"href":"https:\/\/depictdatastudio.com\/wp-json\/wp\/v2\/pages\/14183\/revisions\/16591"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/depictdatastudio.com\/wp-json\/wp\/v2\/media\/71"}],"wp:attachment":[{"href":"https:\/\/depictdatastudio.com\/wp-json\/wp\/v2\/media?parent=14183"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}
